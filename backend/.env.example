# Azure AI Foundry (GPT-4o: detailed analysis + document generation)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_GPT4O_DEPLOYMENT=gpt-4o

# Groq (chat + quick analysis)
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b

# Provider fallback (services/llm.py)
# When the preferred provider is rate-limited, 5xx, or unreachable, the call is
# re-sent once to the other provider. Groq's free tier has a daily token cap,
# and a daily cap is failed over immediately rather than backed off -- retrying
# it only makes the user wait for the same error. Set false to let a provider
# outage surface as a 502 instead.
LLM_FALLBACK_ENABLED=true
# Send chat to Azure GPT-4o first instead of Groq. The switch for a day when
# Groq is capped from the first message and paying for the failed Groq attempt
# on every turn is not worth it. Fallback still applies, in the other direction.
LLM_PREFER_AZURE_FOR_CHAT=false

# Supabase (Postgres + Auth)
# Values below are the local stack defaults printed by `npx supabase start`
# (public demo credentials -- safe to commit). For a cloud project use:
#   SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_JWT_SECRET=<legacy JWT secret from Project Settings > API>
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# CORS (comma-separated)
# A trailing slash or a missing scheme is corrected at startup and logged --
# CORS matches the browser's Origin header by exact string, so
# "applify.vercel.app/" would otherwise match nothing and block the frontend
# with no server-side error to read.
ALLOWED_ORIGINS=http://localhost:5173

# Logging
# Root log level: DEBUG, INFO, WARNING, ERROR. Every line is stamped with the
# request id that also comes back on the X-Request-ID response header.
LOG_LEVEL=INFO
