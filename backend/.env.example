# Azure AI Foundry (GPT-4o: detailed analysis + document generation)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_GPT4O_DEPLOYMENT=gpt-4o

# Groq (chat + quick analysis)
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b

# Supabase (Postgres + Auth)
# Values below are the local stack defaults printed by `npx supabase start`
# (public demo credentials -- safe to commit). For a cloud project use:
#   SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_JWT_SECRET=<legacy JWT secret from Project Settings > API>
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
